# ERA — Variables de entorno (REFERENCIA)
# Este archivo NO lo carga la JVM automáticamente.
# Las variables deben existir como system properties o variables de entorno
# (run configuration de IntelliJ, shell o el mecanismo que use el despliegue).

# Servidor
PORT=8080

# MySQL (base era_db)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=era_db
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# JWT — UN único secreto compartido para sesión y reset token
# (la diferenciación vive en los claims audience, no en el secreto)
JWT_SECRET=<JWT_SECRET>

# Modo dev (Base de Trazabilidad V11): OTP fijo "123456" + SMTP No-Op para el smoke test
# E2E (scripts/smoke_test.ps1). Solo desarrollo local; nunca "true" en produccion.
APP_DEV_MODE=false

# Proveedor de correo (envío de OTP de 6 dígitos — codigos_verificacion)
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<EMAIL_API_KEY>
SMTP_PASSWORD=<EMAIL_API_KEY>
SMTP_FROM=<EMAIL_FROM>

# Storage de avatares personalizados (Módulo I) — directorio local donde se persisten los
# archivos custom:*. Debe existir (el init lo crea) y ser escribible; si no, el servidor
# aborta al arrancar (Fail-Fast).
AVATAR_STORAGE_DIR=<AVATAR_STORAGE_DIR>
